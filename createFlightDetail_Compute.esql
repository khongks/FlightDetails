DECLARE Cache_FlightDetails SHARED ROW;

CREATE COMPUTE MODULE createFlightDetail_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Reference the root of the JSON data from your OpenAPI spec
        DECLARE refIn REFERENCE TO InputRoot.JSON.Data;
        
        IF LASTMOVE(refIn) THEN
            -- 2. Call the function to store the data
            CALL AddFlightToSharedCache(refIn);

			-- 3. Set the HTTP Status to 201 (Created)
            SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 201;
            
            -- 4. Create a simple success response
            SET OutputRoot.JSON.Data.status = 'success';
            SET OutputRoot.JSON.Data.message = 'Flight ' || refIn.flight_number || ' created successfully.';
        ELSE
        	-- Set HTTP Status to 400 (Bad Request) if the payload is empty
            SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
            SET OutputRoot.JSON.Data.error = 'No JSON data found in input message.';
        END IF;
		RETURN TRUE;
	END;
	
	-- The specific function to handle the shared row logic
    CREATE PROCEDURE AddFlightToSharedCache(IN refIn REFERENCE)
    BEGIN
        -- Extract the flight number to use as the unique index
        DECLARE flightKey CHAR refIn.flight_number;
        
        -- Use ATOMIC to prevent race conditions if multiple threads update the same flight
        BEGIN ATOMIC
            -- We store the entire object under the flight_number key
            -- This copies nested objects like 'amenities' and 'origin' perfectly
            SET Cache_FlightDetails.FlightDetail.{flightKey} = refIn;
            
            -- Optional: Add a timestamp of when it was cached
            SET Cache_FlightDetails.FlightDetail.{flightKey}.cached_at = CURRENT_TIMESTAMP;
        END;
    END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
