

CREATE COMPUTE MODULE listFlightDetails_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Extract the optional status filter from the query parameter
        DECLARE filterStatus CHAR InputLocalEnvironment.REST.Input.Parameters.status;
        
        -- 2. Establish references for looping through the cache structure
        DECLARE refFlights REFERENCE TO Cache_FlightDetails.FlightDetail;
        DECLARE refFlight REFERENCE TO refFlights.*[1];
        
        -- 3. Success: Set HTTP Status to 200 (OK)
        SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
        
        -- Initialize the output array inside JSON.Data
        CREATE FIELD OutputRoot.JSON.Data IDENTITY (JSON.Array)Data;
        DECLARE outIndex INT 1;
        
        -- 4. Loop through all cached flights
        WHILE LASTMOVE(refFlight) DO
            -- If no status query param is supplied, return all records. 
            -- Otherwise, strictly filter by matching status values.
            IF filterStatus IS NULL OR refFlight.status = filterStatus THEN
                -- Append a deep copy of the flight data into the output array
                SET OutputRoot.JSON.Data.Item[outIndex] = refFlight;
                SET OutputRoot.JSON.Data.Item[outIndex].cached_at = NULL; -- Strip internal tracking
                SET outIndex = outIndex + 1;
            END IF;
            
            -- Move the pointer to the next flight record in the Shared Row
            MOVE refFlight NEXTSIBLING;
        END WHILE;
        
        -- Return a clean 200 OK with an empty array if no matches are found
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
