

CREATE COMPUTE MODULE updateFlightDetail_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Extract flightNumber from the REST Path Parameter
        DECLARE flightKey CHAR InputLocalEnvironment.REST.Input.Parameters.flightNumber;
        
        -- 2. Reference the existing record in our Shared Row cache
        DECLARE refCache REFERENCE TO Cache_FlightDetails.FlightDetail.{flightKey};
        
        -- 3. Success: Set HTTP Status to 200 (OK)
        SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
        
        -- 4. Reference the incoming partial update payload
        DECLARE refIn REFERENCE TO InputRoot.JSON.Data;
        
        IF LASTMOVE(refCache) THEN
        	
            IF LASTMOVE(refIn) THEN
                -- Thread-safe execution for updating the cache
                BEGIN ATOMIC
                    -- Only overwrite fields if they are explicitly sent in the payload
                    IF refIn.status IS NOT NULL THEN
                        SET refCache.status = refIn.status;
                    END IF;
                    
                    IF refIn.gate IS NOT NULL THEN
                        SET refCache.gate = refIn.gate;
                    END IF;
                    
                    IF refIn.departure_time IS NOT NULL THEN
                        SET refCache.departure_time = refIn.departure_time;
                    END IF;
                    
                    IF refIn.arrival_time IS NOT NULL THEN
                        SET refCache.arrival_time = refIn.arrival_time;
                    END IF;
                    
                    -- Nested structure handling for amenities
					IF FIELDTYPE(refIn.amenities) IS NOT NULL THEN
					    SET refCache.amenities = refIn.amenities;
					END IF;
                    
                    -- Update tracking metadata
                    SET refCache.cached_at = CURRENT_TIMESTAMP;
                END;
                
                -- Construct Success Response (Returns full updated record per your spec)
                CREATE FIELD OutputRoot.JSON.Data;
                SET OutputRoot.JSON.Data = refCache;
                SET OutputRoot.JSON.Data.cached_at = NULL; -- Hide cache metadata from client
                
            ELSE
                -- Request Body Missing
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
                SET OutputRoot.JSON.Data.error = 'Bad Request';
                SET OutputRoot.JSON.Data.details = 'Missing JSON payload for update.';
            END IF;
        ELSE
            -- Target Flight Not Found
            SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404;
            SET OutputRoot.JSON.Data.error = 'Flight Not Found';
            SET OutputRoot.JSON.Data.requested_id = flightKey;
        END IF;
        
        RETURN TRUE;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
